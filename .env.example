# Copy to .env or run make configure. Node.js >=22; npm start loads ../.env.
HOST=127.0.0.1
PORT=3081
# / for a dedicated domain; /maia-meet/ for Maia Apps.
BASE_PATH=/
MAX_PARTICIPANTS=6
MAX_MESSAGE_BYTES=65536
RATE_LIMIT_MESSAGES=120
# Optional comma-separated browser origins, including scheme and nonstandard port.
ALLOWED_ORIGINS=
# This configuration is delivered to meeting participants. Never put a TURN
# shared authentication secret here; use a dedicated TURN username/credential.
ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
ICE_TRANSPORT_POLICY=all
# Experimental SFU only; not required or started by the mesh application.
MAIA_CONTROL_BIND=127.0.0.1
MAIA_CONTROL_PORT=3082
MAIA_UDP_BIND=0.0.0.0
MAIA_UDP_PORT_MIN=10000
MAIA_UDP_PORT_MAX=10100

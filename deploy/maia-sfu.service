[Unit]
Description=Maia SFU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maia
Group=maia
EnvironmentFile=/etc/maia-meet/meet.env
ExecStart=/opt/maia-meet/build/sfu/maia-sfu
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

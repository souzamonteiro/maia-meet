[Unit]
Description=Maia Meet HTTP and WebSocket server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maia
Group=maia
WorkingDirectory=/opt/maia-meet/signaling
Environment=NODE_ENV=production
EnvironmentFile=/etc/maia-meet/meet.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

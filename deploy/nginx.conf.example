# Dedicated domain example. Change domain, TLS files and listening port.
# Generate the location using deploy/render-nginx.mjs for your HOST/PORT/BASE_PATH
# and save it as /etc/nginx/maia-meet-location.conf.
server {
    listen 443 ssl;
    server_name meet.example.com;
    ssl_certificate /etc/letsencrypt/live/meet.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/meet.example.com/privkey.pem;
    include /etc/nginx/maia-meet-location.conf;
}
